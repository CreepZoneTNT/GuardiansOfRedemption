Dialogue: {
	Janitor: {
		UsedMop: Another week, another mop to replace... Ah, new guy, didn't notice ya there. I see you're eyeballin' my mop... I was gonna change it for a new one, but you look like you're in need of a new mop yourself, eh? I guess I can sell it to you, but it'll cost youse a bit extra for the maintenance.
		WTFMan: You know what you did! Make my job harder why don't ya...
		Peeved: The things ya see here... I saw a bit of sludge on the wall, and I went to clean it but it was gone! Then I turned around and it was there again! And then it was gone again! I don't even know if it was real or not!
	}
}

Conditions.EarlyMorning: Mods.GuardiansOfRedemption.Conditions.EarlyMorning

Configs: {
	ClientConfig: {
		DisplayName: Client Config
		Headers.ClientTweaks: Client Tweaks Header

		ClassTooltipMode: {
			Label: Class Tooltip Mode
			Tooltip: ""
		}
	}

	ServerConfig: {
		DisplayName: Server Config
		Headers.OpinionatedChanges: Opinionated Changes

		EnableRecipeBrowserCompat: {
			Label: Enable Recipe Browser Compat
			Tooltip: "3"
		}

		RecipeBrowserCompatIcon: {
			Label: Recipe Browser Compat Icon
			Tooltip: The item to use as the icon for the Opposing weapon tab for Recipe Browser compatibility.
		}

		ReforgesGoBeyondPurple: {
			Label: Reforges Go Beyond Purple
			Tooltip:
				'''
				Ever noticed how [c/B428FF:Purple]-tier items can't have their rarities modified by high-value prefixes, because they're capped to 11? How ugly! 
				Enabling this adds extra logic to break this barrier and let [c/FF2864:Red]/[c/B428FF:Purple]-tier items achieve the higher rarities they deserve!
				'''
		}

		VanillaGoesBeyondPurple: {
			Label: Vanilla Goes Beyond Purple
			Tooltip:
				'''
				If true, then vanilla items will be able to reach high rarities while prefixed.
				(As there are no vanilla items that have a base rarity of [c/B428FF:Purple], this will most likely be [c/00FFC8:Turquoise] for [c/FF2864:Red] items)
				'''
		}

		ModsToGoBeyondPurple: {
			Label: Mods To Go Beyond Purple
			Tooltip:
				'''
				If a modded item's source matches one of the mod names listed here,
				setting its value will enable/disable the ability for that mod's [c/FF2864:Red]/[c/B428FF:Purple]-tier items
				to achieve [c/00FFC8:Turquoise] or [c/FF7F50:Coral] rarity while prefixed.
				(A use case is if another mod already adds higher rarity tiers or their own rarity-adjusting mechanics, to avoid conflict.)
				'''
		}

		EnableCoralRarityForReforges: {
			Label: Enable Coral Rarity For Reforges
			Tooltip:
				'''
				Raising the rarity limit up to [c/00FFC8:Turquoise] not good enough for you?
				Enabling this will add a 13th [c/FF7F50:Coral] rarity for [c/B428FF:Purple]/[c/00FFC8:Turquoise]-tier items to achieve!
				'''
		}

		SetModeForBeyondPurple: {
			Label: Set Mode For Beyond Purple
			Tooltip: ""
		}
	}

	ClassTagModes: {
		Tooltip: ""

		Show: {
			Label: Show
			Tooltip: Force all class tags for Guardians of Redemption's weapons to show
		}

		Hide: {
			Label: Hide
			Tooltip: Force all class tags for Guardians of Redemption's weapons to remain hidden
		}

		FollowOrchid: {
			Label: Follow Orchid
			Tooltip: Display class tags for Guardians of Redemption's weapons only if Orchid's class tags are enabled, or vice versa
		}
	}

	BeyondRarityModes: {
		Tooltip: ""

		Soft: {
			Label: Soft
			Tooltip:
				'''
				Visually modifies the rarity color of the prefixed item.
				Since the rarity itself is untouched, this is the safest option. However, the modified rarity only appears in the inventory, not when reforging. 
				'''
		}

		Hard: {
			Label: Hard
			Tooltip:
				'''
				Functionally modifies the rarity value of the prefixed item.
				Because the rarity itself is modified, the modified rarity will appear in all possible contexts. However, there may be a tiny chance of this system breaking spectacularly, so use caution. 
				'''
		}
	}
}

